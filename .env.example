# Copy to .env.local and fill in. Never commit .env.local.

# Production webhook URL from the n8n "Webhook" node.
# Looks like: https://<your-instance>.app.n8n.cloud/webhook/portfolio-agent
N8N_WEBHOOK_URL=

# Any long random string. Must match the value in the workflow's
# "Verify Secret" IF node. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_SHARED_SECRET=
